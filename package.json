{
  "name": "getway-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Getway Chat for macOS, Windows and Linux: agent-getway's web chat in its own window, signed in through auth.f-proj.com.",
  "author": {
    "name": "vasyaod",
    "email": "vasyaod@users.noreply.github.com"
  },
  "homepage": "https://github.com/vasyaod/agent-getway-desktop",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --import ./test/fake-electron/register.mjs test/*.test.mjs",
    "dist": "electron-builder --publish never",
    "icons": "python3 scripts/make-icons.py"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.fproj.getway.desktop",
    "productName": "Getway Chat",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "GetwayChat-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Getway Chat records voice messages for your agent."
      },
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "GetwayChat-win-${arch}.${ext}",
      "target": [
        { "target": "nsis", "arch": ["x64", "arm64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "category": "Network;Chat",
      "icon": "build/icon.png",
      "executableName": "getway-chat",
      "maintainer": "vasyaod <vasyaod@users.noreply.github.com>",
      "synopsis": "agent-getway's chat as a desktop app",
      "artifactName": "GetwayChat-linux-${arch}.${ext}",
      "target": [
        { "target": "AppImage", "arch": ["x64", "arm64"] },
        { "target": "deb", "arch": ["x64", "arm64"] }
      ]
    }
  }
}
